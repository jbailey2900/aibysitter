<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Samples\sample-rules.md" LogicalName="Aibysitter.Web.Samples.sample-rules.md" />
    <EmbeddedResource Include="Gallery\Content\**\*" Exclude="Gallery\Content\LICENSE" LogicalName="gallery/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Notes\Content\*.md" LogicalName="notes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Incidents\Content\*.md" LogicalName="incidents/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\hooks\pre-commit;..\..\hooks\claude-code-settings.json" LogicalName="hooks/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aibysitter.Rules.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aibysitter.Rules\Aibysitter.Rules.csproj" />
    <ProjectReference Include="..\Aibysitter.Packs\Aibysitter.Packs.csproj" />
    <ProjectReference Include="..\Aibysitter.Rules.Browser\Aibysitter.Rules.Browser.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Browser lint engine patterns, generated from the C# rules on every build and publish. Not committed. -->
  <PropertyGroup>
    <RulesPatternsFile>wwwroot/js/generated/rules-patterns.mjs</RulesPatternsFile>
  </PropertyGroup>

  <!--
    The generated folder never comes from the wwwroot glob: once a build has written the file, the glob would add it
    as wwwroot\js\generated\... on Windows next to the target's wwwroot/js/generated/..., and static web assets fails
    with a duplicate key (MSB4018 in DiscoverPrecompressedAssets). ExportRulesPatterns adds it exactly once.
  -->
  <ItemGroup>
    <Content Remove="wwwroot/js/generated/**" />
  </ItemGroup>

  <Target Name="ExportRulesPatterns" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Aibysitter.Rules.Browser\Aibysitter.Rules.Browser.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_RulesPatternsExporter" />
    </MSBuild>
    <PropertyGroup>
      <_DotNetHost>$(DOTNET_HOST_PATH)</_DotNetHost>
      <_DotNetHost Condition="'$(_DotNetHost)' == ''">dotnet</_DotNetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_DotNetHost)&quot; &quot;@(_RulesPatternsExporter)&quot; &quot;$(RulesPatternsFile)&quot;" />
    <ItemGroup>
      <Content Include="$(RulesPatternsFile)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>

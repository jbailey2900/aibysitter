@page
@model IndexModel
@{
    ViewData["Title"] = "Lint the rules you give AI coding agents";
    ViewData["Description"] = "Lint CLAUDE.md, AGENTS.md, Cursor rules, Copilot instructions, GEMINI.md and .windsurfrules. Line-level findings, a fix for each, and a score. Free, no account.";
    var demo = Model.Demo;
}

<section class="hero">
    <h1>Lint the rules you give AI coding agents.</h1>
    <p class="lede">Paste a CLAUDE.md, AGENTS.md, Cursor rule, Copilot instructions, GEMINI.md, or .windsurfrules. Get line-level findings and a score for the instructions your agent reads before it writes code.</p>
    <p class="actions">
        <a class="button primary" asp-page="/Lint">Lint a file</a>
        <a class="button" asp-page="/Lint" asp-route-sample="true">Open the sample</a>
    </p>
    <ul class="status" aria-label="Status">
        <li><a asp-page="/Lint">Browser linter</a> <span>Available now</span></li>
        <li><a asp-page="/GitHub">GitHub App</a> <span>Available now</span></li>
        <li><a asp-page="/Hooks">CLI and Action</a> <span>Available now</span></li>
    </ul>
</section>

<figure class="terminal" aria-label="Example lint result">
    <pre><code><span class="t-prompt">Lint result:</span> @demo.FileName
@foreach (var line in demo.Lines)
{
@:<span class="t-loc">@demo.FileName:@line.Line.ToString().PadRight(3)</span> <span class="t-sev t-@line.Severity.ToString().ToLowerInvariant()">@line.Severity.ToString().ToLowerInvariant().PadRight(7)</span> <span class="t-rule">@line.RuleId</span>  @line.Message
}
<span class="t-sum">@demo.Lines.Count findings, Aibysitter lint score @demo.Score.Value/100 (@demo.Score.Grade)</span></code></pre>
    <figcaption>Output from the embedded sample, linted by the same engine as the <a asp-page="/Lint">lint page</a>.</figcaption>
</figure>

<section class="section">
    <h2>What it checks</h2>
    <div class="columns">
        <div>
            <h3>Rules files, available now</h3>
            <ul class="marks">
                @foreach (var doc in Model.LintRuleDocs)
                {
                    <li><a asp-page="/Rules/Rule" asp-route-id="@doc.Id">@doc.Id</a> @doc.Summary</li>
                }
            </ul>
        </div>
        <div>
            <h3>Pull requests, GitHub App</h3>
            <ul class="marks">
                @foreach (var check in Model.PullRequestChecks)
                {
                    <li><a asp-page="/Rules/Rule" asp-route-id="@check.Id">@check.Id</a> @check.Title</li>
                }
                @foreach (var doc in Model.AppOnlyRuleDocs)
                {
                    <li><a asp-page="/Rules/Rule" asp-route-id="@doc.Id">@doc.Id</a> @doc.Summary <span class="note">App-only</span></li>
                }
            </ul>
            <p class="note">Pull request checks run through the <a asp-page="/GitHub">Aibysitter GitHub App</a>.</p>
        </div>
    </div>
</section>

<section class="section">
    <h2>Example rules files</h2>
    <p>Public-domain rules files for common stacks and agents, each scored by the linter.</p>
    <ul class="marks">
        @foreach (var entry in Model.GalleryEntries)
        {
            <li><a asp-page="/Gallery/Entry" asp-route-id="@entry.Id">@entry.Name</a></li>
        }
    </ul>
    <p><a asp-page="/Gallery/Index">Browse the gallery</a></p>
</section>

<section class="section">
    <h2>How the Aibysitter lint score works</h2>
    <partial name="_Scoring" />
    <p>Code blocks are ignored.</p>
    <p><a asp-page="/Rules/Index">Read the rules</a></p>
</section>
